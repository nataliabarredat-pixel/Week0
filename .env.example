# SUPABASE CONFIGURATION
# -------------------------------------------------------------
# Replace these values with your actual Supabase API credentials.
# You can find these in your Supabase Dashboard under Project Settings > API.

# The public URL of your Supabase project (e.g. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-supabase-url.supabase.co

# The public anonymous API key for your Supabase project
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-here
